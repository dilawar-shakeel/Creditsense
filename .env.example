APP_NAME=CreditSense
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Fix 0-A: use "localhost" when running the app directly on your machine (the case
# you hit first after cloning). docker-compose.yml overrides this to the "db" hostname
# for the containers automatically, so you do not need to edit it for Docker use.
DATABASE_URL=postgresql+psycopg://creditsense:creditsense@localhost:5432/creditsense
# Docker Compose value (already set by docker-compose.yml, shown here for reference):
# DATABASE_URL=postgresql+psycopg://creditsense:creditsense@db:5432/creditsense

AGENT_NAME=creditsense-agent
POSTGRES_DB=creditsense
POSTGRES_USER=creditsense
POSTGRES_PASSWORD=creditsense

# Fix 0-C: needed from Phase 4 (embeddings) and Phase 5 (agents) onward.
OPENAI_API_KEY=

# Phase 6 -- MCP server. Two fixed bearer tokens (not a full OAuth authorization
# server; see src/creditsense/mcp_server/auth.py for why). Only meaningful on the
# MCP server's HTTP transport (mounted at /mcp on the app service) -- stdio (the
# local Claude Desktop / Claude Code case) has no token concept at all. Change these
# before exposing the HTTP transport outside your own machine.
MCP_READ_API_KEY=creditsense-read-demo-key
MCP_WRITE_API_KEY=creditsense-write-demo-key

# The externally-reachable origin this app is served from. Leave as-is for local use.
# To connect a remote MCP client that speaks OAuth (Claude Desktop's chat connector),
# put a tunnel in front of port 8000 (e.g. `cloudflared tunnel --url http://localhost:8000`
# or `ngrok http 8000`) and set this to that https:// origin, then restart the app:
# it becomes the OAuth issuer/resource URL (which clients compare by exact string) and
# is allow-listed for MCP's DNS-rebinding Host check. While such a tunnel is running,
# anyone with the URL can complete the auto-approve OAuth flow and reach every MCP
# tool, including the write one -- start it deliberately, stop it when you're done.
MCP_PUBLIC_BASE_URL=http://localhost:8000
