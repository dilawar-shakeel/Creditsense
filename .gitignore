.env
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.py[cod]


# Generated datasets
src/creditsense/data/raw/*.csv

# Trained model files
src/creditsense/ml/artifacts/*.joblib
# Fix 1-C: *.metrics.json is a few hundred bytes with no personal data, and it's the
# file holding the numbers worth quoting (AUC, cutoff trade-off table, etc.) — commit
# it so those numbers exist somewhere besides one laptop. Only the large binary
# .joblib bundle and the metadata JSON (regenerated by training) stay ignored.
src/creditsense/ml/artifacts/*.metadata.json

# RAG embedding cache (P4.3) — local dev speedup, not corpus content
src/creditsense/data/raw_corpus/.embedding_cache.jsonl